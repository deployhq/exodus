---
interface Props {
	/** Prefix for the landing's section anchors: '' on the landing, '/' on other pages. */
	base?: string;
}
const { base = '' } = Astro.props;
---

<header class="site-header">
	<a href="/" class="brand">
		<span class="brand-mark" aria-hidden="true">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
		</span>
		Exodus <span class="brand-by">by DeployHQ</span>
	</a>
	<nav aria-label="Main">
		<a href={`${base}#how`}>How it works</a>
		<a href={`${base}#what`}>What converts</a>
		<a href={`${base}#why`}>Why Astro</a>
		<a href={`${base}#preview`} class="nav-cta">Build my preview</a>
	</nav>
</header>

<style>
	.site-header {
		max-width: 1200px;
		margin: 0 auto;
		padding: 22px 24px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--fg);
		text-decoration: none;
		font-weight: 700;
		font-size: 20px;
		letter-spacing: -0.01em;
	}
	.brand-mark {
		width: 32px;
		height: 32px;
		border-radius: 9px;
		background: var(--violet);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.brand-by {
		font-size: 14px;
		font-weight: 500;
		color: var(--muted);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 28px;
		font-size: 15px;
	}
	nav a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--fg);
	}
	.nav-cta {
		color: var(--fg);
		border: 1px solid rgba(255, 255, 255, 0.3);
		padding: 10px 18px;
		border-radius: 999px;
	}
	@media (max-width: 640px) {
		.site-header {
			padding: 18px 16px;
		}
		nav a:not(.nav-cta) {
			display: none;
		}
	}
</style>

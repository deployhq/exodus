---
interface Props {
	id: string;
}

const { id } = Astro.props;
---

<form class="url-form" data-exodus-form novalidate>
	<label for={id} class="visually-hidden">Your WordPress site URL</label>
	<input
		id={id}
		name="url"
		type="url"
		inputmode="url"
		autocomplete="url"
		placeholder="https://yoursite.com"
		required
	/>
	<button type="submit">Build my preview</button>
	<p class="url-form-status" role="status" aria-live="polite" hidden></p>
</form>

<script>
	import { submitErrorMessage } from '../lib/ui/progress.ts';

	declare global {
		interface Window {
			gtag?: (...args: unknown[]) => void;
		}
	}

	function track(event: string, params: Record<string, unknown> = {}) {
		window.gtag?.('event', event, params);
	}

	function normalize(raw: string): URL | null {
		const value = raw.trim();
		if (!value) return null;
		try {
			const url = new URL(/^https?:\/\//i.test(value) ? value : `https://${value}`);
			return url.hostname.includes('.') ? url : null;
		} catch {
			return null;
		}
	}

	// POST /api/jobs; resolves with the job id, rejects with visitor-facing copy (never the
	// server's own error text, which is written for operators).
	async function start(url: string): Promise<string> {
		let res: Response;
		try {
			res = await fetch('/api/jobs', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ url }),
			});
		} catch {
			throw 'We couldn’t reach Exodus. Check your connection and try again.';
		}
		if (!res.ok) throw submitErrorMessage(res.status);
		const body = await res.json().catch(() => null);
		if (!body?.id) throw submitErrorMessage(500);
		return body.id;
	}

	document.querySelectorAll<HTMLFormElement>('[data-exodus-form]').forEach((form) => {
		const input = form.querySelector('input')!;
		const status = form.querySelector<HTMLElement>('.url-form-status')!;
		const button = form.querySelector('button')!;
		// Back/forward cache can restore the page with the button still disabled.
		window.addEventListener('pageshow', () => (button.disabled = false));

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const url = normalize(input.value);

			if (!url) {
				status.textContent = 'Enter a full site address, like https://yoursite.com.';
				status.hidden = false;
				input.setAttribute('aria-invalid', 'true');
				return;
			}

			input.removeAttribute('aria-invalid');
			track('exodus_url_submitted', { hostname: url.hostname });

			status.hidden = true;
			button.disabled = true;
			start(url.href)
				.then((id) => location.assign(`/migration?id=${encodeURIComponent(id)}`))
				.catch((message: string) => {
					status.textContent = message;
					status.hidden = false;
					input.setAttribute('aria-invalid', 'true');
					button.disabled = false;
				});
		});
	});
</script>

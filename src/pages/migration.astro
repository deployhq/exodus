---
// Progress and result for one preview build: /migration?id=<job id>. Static page; the job id is
// read in the browser, so a reload resumes the same job. Never indexed.
// Copy rules (CLAUDE.md): never render step labels, the log, repo/project URLs, reports or
// server error text; no custom domains; "claim" leads to signup only.
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CLAIM_URL } from '../lib/ui/config.ts';
import '../styles/brand.css';

const title = 'Your preview | Exodus by DeployHQ';
const description = 'Follow your WordPress to Astro preview build.';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Seo title={title} description={description} path="/migration" noindex />
	</head>
	<body>
		<SiteHeader base="/" />
		<main>
			<section class="screen working card" data-screen="working">
				<div class="spinner" aria-hidden="true"></div>
				<h1 class="visually-hidden">Building your preview</h1>
				<p class="status-line" aria-live="polite" data-status>Getting started…</p>
				<p class="elapsed">Elapsed <span class="mono" data-elapsed>0:00</span></p>
				<p class="expect">This usually takes 2–3 minutes. You can leave this tab open.</p>
				<noscript><p>This page needs JavaScript to follow your preview build.</p></noscript>
			</section>

			<section class="screen" data-screen="succeeded" hidden>
				<div class="card result">
					<h1 tabindex="-1">Your website is live</h1>
					<p class="live-url mono" data-live-url></p>
					<p><a class="btn" data-live-link href="#" target="_blank" rel="noopener">See your website live<span class="visually-hidden"> (opens in a new tab)</span><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a></p>
				</div>
				<div class="card card-warn notes" data-notes hidden>
					<h2>Good to know</h2>
					<ul data-notes-list></ul>
				</div>
				<div class="panel claim">
					<div>
						<h2>Next step</h2>
						<p>Claim this site with a DeployHQ account.</p>
					</div>
					<a class="btn btn-pill" data-claim href={CLAIM_URL}>Claim this site</a>
				</div>
			</section>

			<section class="screen card" data-screen="failed" hidden>
				<h1 tabindex="-1">We couldn't build this preview</h1>
				<p data-failure></p>
				<p><a class="btn" href="/#preview">Try again</a></p>
			</section>

			<section class="screen card" data-screen="missing" hidden>
				<h1 tabindex="-1">We couldn't find that preview</h1>
				<p>Check the link, or start a new preview.</p>
				<p><a class="btn" href="/#preview">Build a new preview</a></p>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>

<script>
	import type { Job } from '../lib/migration/jobs.ts';
	import {
		statusMessage,
		viewFor,
		liveLink,
		failureMessage,
		warningNotes,
		formatElapsed,
		elapsedMs,
		hostnameOf,
		isJobId,
	} from '../lib/ui/progress.ts';

	declare global {
		interface Window {
			gtag?: (...args: unknown[]) => void;
		}
	}

	type Screen = 'working' | 'succeeded' | 'failed' | 'missing';

	const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
	const statusEl = $('[data-status]');
	const elapsedEl = $('[data-elapsed]');
	const liveLinkEl = $<HTMLAnchorElement>('[data-live-link]');
	const liveUrlEl = $('[data-live-url]');
	const notesEl = $('[data-notes]');
	const notesList = $('[data-notes-list]');
	const failureEl = $('[data-failure]');

	let current: Job | null = null;
	let shown: Screen = 'working';

	function track(event: string, params: Record<string, unknown> = {}) {
		window.gtag?.('event', event, params);
	}

	function show(screen: Screen) {
		document.querySelectorAll<HTMLElement>('[data-screen]').forEach((el) => {
			el.hidden = el.dataset.screen !== screen;
		});
		if (screen !== shown && screen !== 'working') {
			document.querySelector<HTMLElement>(`[data-screen="${screen}"] h1`)?.focus();
		}
		shown = screen;
	}

	function tick() {
		if (current) elapsedEl.textContent = formatElapsed(elapsedMs(current, Date.now()));
	}
	setInterval(tick, 1000);

	// Fire once per job, even across reloads of a finished job.
	function trackOnce(event: string, job: Job) {
		const key = `exodus:${event}:${job.id}`;
		try {
			if (sessionStorage.getItem(key)) return;
			sessionStorage.setItem(key, '1');
		} catch {}
		track(event, { hostname: hostnameOf(job.url) });
	}

	function render(job: Job) {
		current = job;
		tick();
		const view = viewFor(job);
		if (view === 'progress') {
			const msg = statusMessage(job);
			if (statusEl.textContent !== msg) statusEl.textContent = msg;
			show('working');
		} else if (view === 'succeeded') {
			const href = liveLink(job);
			if (href) {
				liveLinkEl.href = href;
				liveUrlEl.textContent = href;
			}
			const notes = warningNotes(job);
			notesList.replaceChildren(
				...notes.map((n) => Object.assign(document.createElement('li'), { textContent: n })),
			);
			notesEl.hidden = notes.length === 0;
			show('succeeded');
			trackOnce('exodus_preview_ready', job);
		} else {
			failureEl.textContent = failureMessage(job);
			show('failed');
		}
	}

	const terminal = (job: Job) => job.status === 'succeeded' || job.status === 'failed';
	const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

	// Polling fallback (docs/MIGRATION-SERVICE.md): GET every 2 s until the job ends.
	async function poll(statusUrl: string) {
		for (;;) {
			try {
				const res = await fetch(statusUrl);
				if (res.status === 404) return show('missing');
				if (res.ok) {
					const job: Job = await res.json();
					render(job);
					if (terminal(job)) return;
				}
			} catch {}
			await wait(2000);
		}
	}

	// EventSource first; on error, one GET decides whether the job ended, is unknown, or the
	// stream should be replaced by polling.
	function follow(id: string) {
		const statusUrl = `/api/jobs/${encodeURIComponent(id)}`;
		if (!('EventSource' in window)) return void poll(statusUrl);
		const es = new EventSource(`${statusUrl}/events`);
		es.addEventListener('job', (e) => {
			const job: Job = JSON.parse((e as MessageEvent).data);
			render(job);
			if (terminal(job)) es.close();
		});
		es.onerror = async () => {
			try {
				const res = await fetch(statusUrl);
				if (res.status === 404) {
					es.close();
					return show('missing');
				}
				if (res.ok) {
					const job: Job = await res.json();
					render(job);
					if (terminal(job)) return es.close();
				}
			} catch {}
			if (es.readyState === EventSource.CLOSED) poll(statusUrl);
		};
	}

	liveLinkEl.addEventListener('click', () => {
		if (current) track('exodus_preview_opened', { hostname: hostnameOf(current.url) });
	});
	$('[data-claim]').addEventListener('click', () => {
		if (current) track('exodus_signup_clicked', { hostname: hostnameOf(current.url) });
	});

	async function main() {
		const params = new URLSearchParams(location.search);

		// DEV ONLY: /migration?demo=queued|running|succeeded|failed|notwp renders fixture jobs.
		// `import.meta.env.DEV` is false in production builds, so this branch and the fixture
		// module are removed from the bundle.
		if (import.meta.env.DEV && params.has('demo')) {
			const { demoJob, demoTimeline } = await import('../lib/ui/dev-fixtures.ts');
			const kind = params.get('demo') ?? '';
			if (kind === 'running') {
				const frames = demoTimeline();
				let i = 0;
				render(frames[0]);
				setInterval(() => render(frames[(i = (i + 1) % frames.length)]), 3000);
				return;
			}
			const job = demoJob(kind);
			return job ? render(job) : show('missing');
		}

		const id = params.get('id');
		if (!isJobId(id)) return show('missing');
		follow(id);
	}

	main();
</script>

<style>
	main {
		max-width: 820px;
	}

	main > .screen {
		margin-top: 72px;
	}

	main > .screen:not(.card) {
		padding-top: 0;
	}

	.screen.card {
		padding: 48px;
		border-radius: 20px;
	}

	.screen h1 {
		font-size: clamp(2rem, 6vw, 3.25rem);
	}

	h1:focus {
		outline: none;
	}

	.working {
		text-align: center;
	}

	.working.card {
		padding-top: 56px;
	}

	.status-line {
		margin: 0 0 8px;
		font-size: clamp(1.375rem, 3.5vw, 1.75rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--fg);
	}

	.elapsed {
		margin: 0;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.expect {
		margin: 24px 0 0;
		font-size: 0.9375rem;
		color: var(--subtle);
	}

	.result {
		padding: 40px;
		border-radius: 20px;
		background: var(--surface);
	}

	.live-url {
		margin: 0 0 24px;
		font-size: 0.9375rem;
		color: var(--lavender);
		overflow-wrap: anywhere;
	}

	.notes {
		margin-top: 20px;
	}

	.notes h2,
	.claim h2 {
		margin: 0 0 8px;
		font-size: 1.375rem;
		letter-spacing: -0.01em;
	}

	.notes ul {
		margin: 0;
		padding-left: 1.25rem;
		color: rgba(255, 255, 255, 0.85);
	}

	.claim {
		margin-top: 20px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.claim > div {
		flex: 1 1 280px;
		min-width: 0;
	}

	.claim p {
		margin: 0;
	}

	.claim :focus-visible {
		outline-color: #ffffff;
	}

	.screen.card > p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 640px) {
		main > .screen {
			margin-top: 40px;
		}
		.screen.card,
		.result {
			padding: 28px 20px;
		}
	}
</style>

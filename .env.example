# Copy to .env (gitignored) and fill in. Never commit real values.
# Ask Thiago for the staging credentials (shared through 1Password, not Slack).

# --- DeployHQ API (staging) -----------------------------------------------
# API base URL = https://<DEPLOYHQ_ACCOUNT>.<DEPLOYHQ_HOST>
DEPLOYHQ_HOST=staging.deployhq.com
DEPLOYHQ_ACCOUNT=your-account-subdomain
DEPLOYHQ_EMAIL=you@example.com
# 40-character API key of that user (DeployHQ > Settings > Security)
DEPLOYHQ_API_KEY=replace-me

# --- GitHub (one private repo per migrated site: <GITHUB_OWNER>/exodus-<slug>) ---
# Your own username (or an org you can create repos in)
GITHUB_OWNER=your-github-username
# Optional. Falls back to `gh auth token` when empty.
GITHUB_TOKEN=

# --- Static Hosting custom domain (optional) ------------------------------
# When set, each site also gets <slug>.<zone>. Needs DNS records in that zone
# (CNAME + TXT, listed in the job warnings). Leave empty to skip.
STATIC_HOSTING_CUSTOM_DOMAIN_ZONE=dropsite.dev

# --- Engine (hackathon-wp-static) -----------------------------------------
# Empty = the installed dependency in node_modules. For the demo, point it at a
# local engine checkout so its cached crawls in runs/ can be reused.
EXODUS_ENGINE_DIR=
# 1 = reuse a cached crawl for the same site (skips scan and copy). 0 = crawl fresh.
EXODUS_ENGINE_REUSE=0
# off (default) = skip the page-by-page verification (it takes more than 10 minutes).
# full = run it and attach the reports. See CLAUDE.md.
EXODUS_VERIFY=off
# 1 (default) = host the site at "/" with slash-less links. 0 = keep the original base path.
WP_STATIC_TRANSLATE_ROOT=1
# Extra hosts the engine may crawl, comma-separated (defaults: websitedemos.net,
# wptavern.com, www.addsearch.com). Keep this an explicit list.
WP_STATIC_ALLOW_HOSTS=
